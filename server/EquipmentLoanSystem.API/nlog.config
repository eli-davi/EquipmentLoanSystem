<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="line"
            value="${longdate}|${uppercase:${level}}|${scopeproperty:item=CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message}${onexception:inner= | ${exception:format=tostring}}" />

  <targets async="true">
    <!-- כל הלוגים -->
    <target xsi:type="File" name="allFile"
            fileName="${basedir}/logs/app-${shortdate}.log"
            layout="${line}"
            encoding="utf-8"
            maxArchiveFiles="14"
            archiveEvery="Day" />

    <!-- רק Warning ומעלה: התנגשויות על משאב (Warning) וחריגות (Error) -->
    <target xsi:type="File" name="problemsFile"
            fileName="${basedir}/logs/problems-${shortdate}.log"
            layout="${line}"
            encoding="utf-8" />

    <target xsi:type="Console" name="console" layout="${line}" />
  </targets>

  <rules>
    <!-- רעש של framework: רק אזהרות ומעלה (חוץ מהודעות עלייה/כיבוי) -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="allFile,console" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- הרמה בפועל נקבעת ב-appsettings (Debug בפיתוח, Information בייצור) -->
    <logger name="*" minlevel="Debug" writeTo="allFile,console" />
    <logger name="*" minlevel="Warn" writeTo="problemsFile" />
  </rules>
</nlog>
